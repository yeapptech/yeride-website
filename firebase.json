{
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log",
        "firebase-debug.*.log",
        "*.local"
      ],
      "predeploy": [
        "npm --prefix \"$RESOURCE_DIR\" run lint",
        "npm --prefix \"$RESOURCE_DIR\" run build"
      ],
      "api": {
        "runtime": "nodejs22",
        "region": "us-central1",
        "memory": "256MiB",
        "timeoutSeconds": 60,
        "availableSecrets": [
          "STRIPE_SECRET_KEY",
          "STRIPE_WEBHOOK_SECRET",
          "CHECKR_SECRET_KEY",
          "CHECKR_API_URL",
          "CHECKR_WEBHOOK_SECRET"
        ]
      },
      "stripeRedirect": {
        "runtime": "nodejs22",
        "region": "us-central1",
        "memory": "128MiB",
        "timeoutSeconds": 30,
        "availableSecrets": [
          "STRIPE_WEBHOOK_SECRET"
        ]
      }
    }
  ],
  "emulators": {
    "functions": {
      "port": 5001
    },
    "firestore": {
      "port": 8080
    },
    "ui": {
      "port": 4000
    },
    "auth": {
      "port": 9099
    },
    "storage": {
      "port": 9199
    }
  }
}