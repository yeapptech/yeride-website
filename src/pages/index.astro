		 <script>
            const mobileMenuButton = document.getElementById('mobile-menu-button');
            const mainNavigation = document.getElementById('main-navigation');
            const mainHeader = document.getElementById('main-header');
            const menuIconOpen = document.getElementById('menu-icon-open');
            const menuIconClose = document.getElementById('menu-icon-close');
            function adjustMenuForScreenSize() {
                if (window.innerWidth >= 768) { 
                    mainNavigation.classList.remove('hidden', 'mobile-nav-open-state', 'flex-col'); 
                    mainNavigation.classList.add('flex'); 
                    menuIconOpen.classList.remove('hidden'); 
                    menuIconClose.classList.add('hidden'); 
                } else { 
                   
                    if (!mainNavigation.classList.contains('mobile-nav-open-state')) {
                        mainNavigation.classList.add('hidden'); 
                    }
                    mainNavigation.classList.remove('flex'); 
                    
                    menuIconOpen.classList.remove('hidden'); 
                    menuIconClose.classList.add('hidden'); 
                }
            }
            
            adjustMenuForScreenSize();

            if (mobileMenuButton && mainNavigation && menuIconOpen && menuIconClose) {
                mobileMenuButton.addEventListener('click', () => {
                    mainNavigation.classList.toggle('hidden');
                    
                    mainNavigation.classList.toggle('mobile-nav-open-state');
                    mainNavigation.classList.toggle('flex-col'); 

                    menuIconOpen.classList.toggle('hidden');
                    menuIconClose.classList.toggle('hidden');
                });

                mainNavigation.querySelectorAll('.nav-link').forEach(link => {
                    link.addEventListener('click', () => {
                        if (window.innerWidth < 768) {
                            mainNavigation.classList.add('hidden');
                            mainNavigation.classList.remove('mobile-nav-open-state');
                            mainNavigation.classList.remove('flex-col');
                            menuIconOpen.classList.remove('hidden');
                            menuIconClose.classList.add('hidden');
                        }
                    });
                });
            }

            window.addEventListener('resize', adjustMenuForScreenSize);

            document.querySelectorAll('a[href^="#"]').forEach(anchor => {
                anchor.addEventListener('click', function (e) {
                    e.preventDefault(); 

                    const targetId = this.getAttribute('href').substring(1);
                    const targetElement = document.getElementById(targetId);

                    if (targetElement) {
                        setTimeout(() => {
                            const headerOffset = mainHeader.offsetHeight;
                            window.scrollTo({
                                top: targetElement.offsetTop - headerOffset,
                                behavior: "smooth"
                            });
                        }, 0); 
                    }
                });
            });



            const preRegistrationForm = document.getElementById('pre-registration-form');
            const submitButton = document.getElementById('submit-button');
            const loadingIndicator = document.getElementById('loading-indicator');
            const formMessage = document.getElementById('form-message');

            if (preRegistrationForm && submitButton && loadingIndicator && formMessage) {
                preRegistrationForm.addEventListener('submit', async (e) => {
                    e.preventDefault(); 

                    formMessage.textContent = '';
                    formMessage.classList.add('hidden');
                    formMessage.classList.remove('text-green-600', 'text-red-600');

                    (submitButton as HTMLButtonElement).disabled = true; 
                    submitButton.classList.add('opacity-50', 'cursor-not-allowed');
                    loadingIndicator.classList.remove('hidden');

                    const formData = new FormData(preRegistrationForm as HTMLFormElement); 
                    
                    const data: Record<string, string> = {}; 
                    formData.forEach((value, key) => {
                        data[key] = value.toString();
                    });

                    if (data.password !== undefined && data.confirmPassword !== undefined && data.password !== data.confirmPassword) {
                        formMessage.textContent = 'Error: Passwords do not match.';
                        formMessage.classList.remove('hidden');
                        formMessage.classList.add('text-red-600');
                        (submitButton as HTMLButtonElement).disabled = false;
                        submitButton.classList.remove('opacity-50', 'cursor-not-allowed');
                        loadingIndicator.classList.add('hidden');
                        return; 
                    }

                    const backendEndpoint = 'http://127.0.0.1:5001/yeapp-stage/us-central1/api/v1/auth/register'; 
					console.debug('Submitting pre-registration data:', data);
                    try {
                        const response = await fetch(backendEndpoint, {
                            method: 'POST',
                            headers: {
                                'Content-Type': 'application/json',
                            },
                                body: JSON.stringify({ data: data }),

                        });

                        const result = await response.json();

                        if (response.ok) {
                            formMessage.textContent = 'Pre-registration successful! Thank you.';
                            formMessage.classList.remove('hidden');
                            formMessage.classList.add('text-green-600');
                            (preRegistrationForm as HTMLFormElement).reset(); 
                        } else {
                            const errorMessage = result.message || 'An error occurred during pre-registration.';
                            formMessage.textContent = `Error: ${errorMessage}`;
                            formMessage.classList.remove('hidden');
                            formMessage.classList.add('text-red-600');
                        }
                    } catch (error) {
                        console.error('Error submitting form:', error);
                        formMessage.textContent = 'Error: Could not connect to the server. Please try again later.';
                        formMessage.classList.remove('hidden');
                        formMessage.classList.add('text-red-600');
                    } finally {
                        (submitButton as HTMLButtonElement).disabled = false;
                        submitButton.classList.remove('opacity-50', 'cursor-not-allowed');
                        loadingIndicator.classList.add('hidden');
                    }
                });
            }
        </script>
	</body>
</html>