---
// Body sections below are the pre-redesign content — the brand rebuild of this
// page (Variant D hero, audience fork) is ticket #37.
import BaseLayout from "../layouts/BaseLayout.astro";
import PreRegistrationForm from "../components/PreRegistrationForm.astro";
---

<BaseLayout title="YeRide - Ride Smarter, Earn More">
  <main>
    <section
      class="bg-gradient-to-r from-blue-500 to-blue-700 text-white py-20"
    >
      <div class="container mx-auto px-4 text-center">
        <h1 class="text-4xl md:text-5xl font-bold mb-4">
          Ride Smarter, Earn More with YeRide
        </h1>
        <p class="text-xl mb-8 max-w-2xl mx-auto">
          Connecting drivers and passengers for seamless, fair-priced rides.
        </p>
        <a
          href="/fare-estimate"
          class="bg-white text-blue-600 hover:bg-blue-50 px-8 py-3 rounded-full text-lg font-semibold shadow-md transition duration-300"
        >
          Estimate Your Fare
        </a>
      </div>
    </section>

    <section class="py-16 bg-white">
      <div class="container mx-auto px-4">
        <div class="max-w-3xl mx-auto text-center">
          <p class="text-lg mb-6 text-gray-700 leading-relaxed">
            Our app revolutionizes ride sharing by connecting riders and
            drivers directly, ensuring lower fares for passengers and 100%
            earnings for drivers. Experience a service where every ride
            bolsters the community, not corporate profits.
          </p>
          <p class="text-lg mb-6 text-gray-700 leading-relaxed">
            It's a win-win scenario: every journey guarantees low pricing
            for passengers and a better livelihood for drivers.
          </p>
          <p class="text-lg text-gray-700 leading-relaxed mb-8">
            Join our movement where community thrives. With us, ride or drive
            and enjoy the benefits of a fair, transparent service - more
            savings for riders, more earnings for drivers.
          </p>
          <a
            href="#pre-registration"
            class="bg-blue-600 text-white hover:bg-blue-700 px-8 py-3 rounded-full text-lg font-semibold shadow-md transition duration-300"
          >
            Pre-register Now
          </a>
        </div>
      </div>
    </section>

    <section id="features" class="py-16 bg-white">
      <div class="container mx-auto px-4">
        <h3 class="text-3xl font-bold text-center mb-12">
          Why Choose YeRide?
        </h3>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8">
          <div
            class="bg-blue-50 p-6 rounded-lg shadow-md hover:shadow-lg transition duration-300"
          >
            <h4 class="text-xl font-semibold mb-3 text-blue-600">
              Lower Fares
            </h4>
            <p class="text-gray-700">
              Highly competitive ride prices.
              No dynamic pricing during peek hours. Just fair, transparent rates.
            </p>
          </div>
          <div
            class="bg-green-50 p-6 rounded-lg shadow-md hover:shadow-lg transition duration-300"
          >
            <h4 class="text-xl font-semibold mb-3 text-green-600">
              Higher Earnings
            </h4>
            <p class="text-gray-700">
              No commission or hidden fees. Lower insurance cost.
              Your hard work, your money.
            </p>
          </div>
          <div
            class="bg-yellow-50 p-6 rounded-lg shadow-md hover:shadow-lg transition duration-300"
          >
            <h4 class="text-xl font-semibold mb-3 text-yellow-600">
              Quick Matches
            </h4>
            <p class="text-gray-700">
              Our efficient algorithm ensures fast rider-driver matches for
              minimal wait times.
            </p>
          </div>
          <div
            class="bg-purple-50 p-6 rounded-lg shadow-md hover:shadow-lg transition duration-300"
          >
            <h4 class="text-xl font-semibold mb-3 text-purple-600">
              Community Focused
            </h4>
            <p class="text-gray-700">
              Build a stronger local community with every ride you take or
              give.
            </p>
          </div>
        </div>
      </div>
    </section>

    <section id="users" class="py-16 bg-gray-100">
      <div class="container mx-auto px-4">
        <div class="flex flex-col md:flex-row gap-8">
          <div
            id="riders"
            class="flex-1 bg-white p-8 rounded-lg shadow-lg hover:shadow-xl transition duration-300"
          >
            <h3 class="text-2xl font-bold mb-4 text-blue-600">For Riders</h3>
            <p class="mb-4 text-gray-700">
              Experience a new era of ride sharing where low fares don't
              compromise quality. Our app connects you directly with drivers,
              ensuring lower fares by eliminating commissions and no dinamic pricing practices.
            </p>
            <p class="mb-4 text-gray-700">
              Every ride you take with YeRide not only saves you money but
              also bolsters our community, supporting drivers to earn more.
              Join our movement for a fair, transparent ride sharing
              experience.
            </p>
            <p class="text-gray-700">
              With YeRide, you're not just a passenger, you're a community
              supporter, enjoying more savings and a better riding experience
              every time.
            </p>
          </div>

          <div
            id="drivers"
            class="flex-1 bg-white p-8 rounded-lg shadow-lg hover:shadow-xl transition duration-300"
          >
            <h3 class="text-2xl font-bold mb-4 text-green-600">
              For Drivers
            </h3>
            <p class="mb-4 text-gray-700">
              Transform your driving into higher earnings by
              minimizing ride deductions and ensuring drivers receive a larger
              net share of the fare, targeting 70-75% of the total fare on average,
              compared to Uber/Lyft drivers.
            </p>
            <p class="mb-4 text-gray-700">
              This means a better livelihood for you as a driver. Be a part of
              a movement where every ride you make strengthens the
              community and supports your financial goals.
            </p>
            <p class="text-gray-700">
              Join YeRide and enjoy the benefits of a transparent, fair
              service where your hard work pays off - more earnings, more
              freedom, more community.
            </p>
          </div>
        </div>
      </div>
    </section>

    <section
      id="pre-registration"
      class="bg-gradient-to-r from-blue-600 to-blue-500 py-16"
    >
      <div class="container mx-auto px-4">
        <div class="max-w-2xl mx-auto">
          <div class="text-center mb-8">
            <h2 class="text-3xl font-bold text-white mb-4">
              Join the YeRide Community Early!
            </h2>
            <p class="text-blue-100 text-lg">
              Be among the first to experience fair, transparent ride sharing.
              Pre-register now and get exclusive early access when we launch
              in your area.
            </p>
          </div>

          <PreRegistrationForm />
        </div>
      </div>
    </section>

    <section id="download" class="py-16 bg-white">
      <div class="container mx-auto px-4 text-center">
        <h3 class="text-3xl font-bold mb-8">Download YeRide Today</h3>
        <p class="text-xl mb-8 text-gray-700">
          Start your smarter ride experience now!
        </p>
        <div class="flex justify-center space-x-4">
          <a
            href="https://testflight.apple.com/join/99zjYHZ4"
            class="inline-block transition duration-300 transform hover:scale-105"
          >
            <img
              src="/images/Download_on_the_App_Store_Badge_US-UK_RGB_blk_092917.svg"
              alt="Download on the App Store"
              class="h-14 w-auto"
            />
          </a>
          <a
            href="https://play.google.com/store/apps/details?id=app.yeride&hl=en-US&ah=GVV2SPMWyPPVqvjMsKyeNzrwNEQ"
            class="inline-block transition duration-300 transform hover:scale-105"
          >
            <img
              src="/images/GetItOnGooglePlay_Badge_Web_color_English.png"
              alt="Get it on Google Play"
              class="h-14 w-auto"
            />
          </a>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>

<style is:global>
  html {
    scroll-behavior: smooth;
  }
</style>
