---
// PROTOTYPE (wayfinder #33) — Variant D: "The Hail" — MOBILE-FIRST
// Chosen direction. Cab Yellow as the hero GROUND, the MARK leading instead of type,
// then an inversion to Ink for the fork, landing on paper.
//
// Authored small-screen-first per the repo convention: every base class is the phone
// composition, and sm/md/lg only ever add. The desktop composition (mark beside the
// headline, two-up fork, facts on one row) is preserved from md up.
//
// Small-screen decisions, deliberate rather than inherited:
//   · The mark stacks ABOVE the headline and shrinks — side-by-side at 390px would
//     leave the headline ~7 characters wide.
//   · Nav links are dropped below sm; the mark and the language toggle are the only
//     things that survive, because ES parity is not a "nice to have" here. Fees
//     returns at sm, About at md.
//   · The hero CTA goes full-width on phones and shrink-wraps from sm.
//   · The facts strip is a divided vertical list on phones, one row from md — a
//     wrapping flex row reflows into ragged orphans at these lengths.
//
// Brand: the lockup embeds the primary mark, which logo.md forbids on Cab Yellow, so
// the app-icon scheme is the only legal mark on this ground. Cab Yellow is used as
// TEXT for the audience eyebrows — legal on dark grounds only (brand-system.md).
import { copy, type Lang } from './_copy';
const { lang } = Astro.props as { lang: Lang };
const t = copy[lang];
const other = lang === 'en' ? 'es' : 'en';

const sides = [
  { eyebrow: t.driverEyebrow, offer: t.driverOffer, support: t.driverSupport, cta: t.driverCta, href: '/drivers' },
  { eyebrow: t.riderEyebrow, offer: t.riderOffer, support: t.riderSupport, cta: t.riderCta, href: '/riders' },
];
---

<div class="font-brand bg-paper">
  <!-- YELLOW GROUND — the mark leads -->
  <section class="bg-cab-yellow">
    <header class="mx-auto w-full max-w-7xl px-5 py-4 sm:px-6 sm:py-6 flex items-center gap-4">
      {/* app-icon scheme: the lockup embeds the primary mark, illegal on yellow */}
      <a href="/" class="shrink-0">
        <img src="/prototype/yeride-app-icon.svg" alt="YeRide" class="h-9 sm:h-10 w-auto" />
      </a>
      <nav class="ml-auto flex items-center gap-5 sm:gap-7 text-[15px] font-semibold text-ink/75">
        <a href="/fees" class="hidden sm:inline hover:text-ink">{t.nav.fees}</a>
        <a href="/fare-estimate" class="hidden sm:inline hover:text-ink">{t.nav.estimate}</a>
        <a href="/about" class="hidden md:inline hover:text-ink">{t.nav.about}</a>
        <a
          href={`?variant=D&lang=${other}`}
          class="rounded-full border border-ink/30 px-3 py-2 sm:py-1 text-xs font-bold uppercase tracking-caps text-ink/70 hover:border-ink/60"
          >{other}</a
        >
      </nav>
    </header>

    <div
      class="mx-auto max-w-7xl px-5 pb-14 pt-2 sm:px-6 sm:pb-20 md:pb-28 md:pt-6 grid gap-7 md:grid-cols-[auto_1fr] md:items-center md:gap-16"
    >
      <!-- the shipped app-icon at size; its yellow bleed merges with the ground -->
      <img
        src="/prototype/yeride-app-icon.svg"
        alt=""
        class="w-32 sm:w-44 md:w-72 lg:w-80 h-auto shrink-0 -ml-3 md:-ml-8"
      />
      <div>
        <h1
          class="text-ink font-extrabold tracking-headline text-[2rem] leading-[1.06] sm:text-[2.75rem] md:text-[clamp(3rem,6vw,5rem)] md:leading-[1.0] max-w-3xl"
        >
          {t.tagline}
        </h1>
        <p class="mt-4 md:mt-6 text-ink/75 text-[16px] sm:text-[18px] md:text-[clamp(1.05rem,1.5vw,1.3rem)] max-w-xl">
          {t.ratesLine}
        </p>
        <a
          href="/fees"
          class="mt-7 md:mt-9 flex sm:inline-flex w-full sm:w-auto items-center justify-center gap-2 rounded-full bg-ink px-8 py-4 text-paper font-bold text-[17px] hover:bg-pullman-brown"
        >
          {t.feesCta}
          <span aria-hidden="true">→</span>
        </a>
      </div>
    </div>
  </section>

  <!-- INK BAND — the fork -->
  <section class="bg-ink">
    <div class="mx-auto max-w-7xl px-5 py-14 sm:px-6 sm:py-16 md:py-20 grid gap-12 md:grid-cols-2 md:gap-20">
      {
        sides.map((s) => (
          <div>
            {/* Cab Yellow as text is legal here and ONLY here — dark ground, brand moment */}
            <p class="text-xs font-bold uppercase tracking-caps text-cab-yellow">{s.eyebrow}</p>
            <h2 class="mt-3 md:mt-4 text-paper font-extrabold tracking-headline text-[1.6rem] sm:text-[2rem] md:text-[clamp(2rem,3.4vw,2.75rem)] leading-[1.1]">
              {s.offer}
            </h2>
            <p class="mt-3 md:mt-4 text-paper/70 text-[16px] sm:text-[17px] leading-relaxed">
              {s.support}
            </p>
            <a
              href={s.href}
              class="mt-5 md:mt-7 inline-flex items-center gap-2 font-bold text-paper text-[16px] underline underline-offset-4 hover:no-underline"
            >
              {s.cta}
              <span aria-hidden="true">→</span>
            </a>
          </div>
        ))
      }
    </div>
  </section>

  <!-- PAPER LANDING -->
  <section class="bg-paper">
    <div class="mx-auto max-w-7xl px-5 sm:px-6">
      <!-- phones: a divided list. md+: one row. -->
      <ul class="py-4 md:py-14 md:flex md:flex-wrap md:items-center md:gap-x-10 border-b border-ink/10">
        {
          t.facts.map((f) => (
            <li class="py-4 border-b border-ink/10 last:border-b-0 md:border-b-0 md:py-0">
              <span class="text-ink font-bold text-[18px] sm:text-[20px] tracking-headline">{f}</span>
            </li>
          ))
        }
        <li class="py-4 md:py-0 md:ml-auto">
          <span class="text-ink/50 text-[15px]">{t.factsNote}</span>
        </li>
      </ul>
      <div
        class="py-7 md:py-8 flex flex-wrap items-center gap-x-4 gap-y-2 text-[14px] text-ink/55"
      >
        <img src="/prototype/yeride-mark.svg" alt="" class="h-6 w-auto" />
        <span>{t.footerNote}</span>
        <span class="w-full md:w-auto md:ml-auto">© 2026 YeRide</span>
      </div>
    </div>
  </section>
</div>
