---
// PROTOTYPE (wayfinder #33) — Variant D: "The Hail"
// Cab Yellow as the hero GROUND — the one posture none of the others take. The mark
// leads instead of type: the shipped app-icon (figure Pullman, pin paper) is used at
// size, its own yellow bleed merging into the yellow ground. This is exactly what
// docs/logo.md prescribes: "Never place the primary mark on Cab Yellow (the pin head
// vanishes) — use the app-icon scheme (paper pin) there."
// Then the page inverts to an Ink band for the fork, and lands on paper. On the dark
// band, Cab Yellow is used as *text* for the audience eyebrows — permitted on dark
// grounds only ("Brand-moment text switches Pullman → Cab Yellow" — brand-system.md).
import { copy, type Lang } from './_copy';
const { lang } = Astro.props as { lang: Lang };
const t = copy[lang];
const other = lang === 'en' ? 'es' : 'en';

const sides = [
  { eyebrow: t.driverEyebrow, offer: t.driverOffer, support: t.driverSupport, cta: t.driverCta, href: '/drivers' },
  { eyebrow: t.riderEyebrow, offer: t.riderOffer, support: t.riderSupport, cta: t.riderCta, href: '/riders' },
];
---

<div class="font-brand bg-paper">
  <!-- YELLOW GROUND — the mark leads -->
  <section class="bg-cab-yellow relative overflow-hidden">
    <header class="relative z-10 mx-auto w-full max-w-7xl px-6 py-6 flex items-center gap-6">
      {/* the lockup embeds the PRIMARY mark, which logo.md forbids on Cab Yellow —
          on this ground the app-icon scheme is the only legal mark */}
      <a href="/" class="shrink-0">
        <img src="/prototype/yeride-app-icon.svg" alt="YeRide" class="h-10 w-auto" />
      </a>
      <nav class="ml-auto flex items-center gap-7 text-[15px] font-semibold text-ink/75">
        <a href="/fees" class="hover:text-ink">{t.nav.fees}</a>
        <a href="/fare-estimate" class="hover:text-ink">{t.nav.estimate}</a>
        <a href="/about" class="hidden sm:inline hover:text-ink">{t.nav.about}</a>
        <a
          href={`?variant=D&lang=${other}`}
          class="rounded-full border border-ink/30 px-3 py-1 text-xs font-bold uppercase tracking-caps text-ink/70 hover:border-ink/60"
          >{other}</a
        >
      </nav>
    </header>

    <div
      class="relative z-10 mx-auto max-w-7xl px-6 pb-20 pt-6 md:pb-28 grid md:grid-cols-[auto_1fr] items-center gap-10 md:gap-16"
    >
      <!-- the shipped app-icon at size; its yellow bleed merges with the ground -->
      <img
        src="/prototype/yeride-app-icon.svg"
        alt=""
        class="w-44 md:w-72 lg:w-80 h-auto shrink-0 -ml-4 md:-ml-8"
      />
      <div>
        <h1
          class="text-ink font-extrabold tracking-headline text-[clamp(2.5rem,6vw,5rem)] leading-[1.0] max-w-3xl"
        >
          {t.tagline}
        </h1>
        <p class="mt-6 text-ink/75 text-[clamp(1.05rem,1.5vw,1.3rem)] max-w-xl">{t.ratesLine}</p>
        <a
          href="/fees"
          class="mt-9 inline-flex items-center gap-2 rounded-full bg-ink px-8 py-4 text-paper font-bold text-[17px] hover:bg-pullman-brown"
        >
          {t.feesCta}
          <span aria-hidden="true">→</span>
        </a>
      </div>
    </div>
  </section>

  <!-- INK BAND — the fork, two text columns -->
  <section class="bg-ink">
    <div class="mx-auto max-w-7xl px-6 py-20 grid md:grid-cols-2 gap-12 md:gap-20">
      {
        sides.map((s) => (
          <div>
            {/* Cab Yellow as text is legal here and ONLY here — dark ground, brand moment */}
            <p class="text-xs font-bold uppercase tracking-caps text-cab-yellow">{s.eyebrow}</p>
            <h2 class="mt-4 text-paper font-extrabold tracking-headline text-[clamp(1.9rem,3.4vw,2.75rem)] leading-[1.08]">
              {s.offer}
            </h2>
            <p class="mt-4 text-paper/70 text-[17px] leading-relaxed">{s.support}</p>
            <a
              href={s.href}
              class="mt-7 inline-flex items-center gap-2 font-bold text-paper text-[16px] underline underline-offset-4 hover:no-underline"
            >
              {s.cta}
              <span aria-hidden="true">→</span>
            </a>
          </div>
        ))
      }
    </div>
  </section>

  <!-- PAPER LANDING -->
  <section class="bg-paper">
    <div
      class="mx-auto max-w-7xl px-6 py-14 flex flex-wrap items-center gap-x-10 gap-y-4 border-b border-ink/10"
    >
      {t.facts.map((f) => <span class="text-ink font-bold text-[20px] tracking-headline">{f}</span>)}
      <span class="text-ink/50 text-[15px] ml-auto">{t.factsNote}</span>
    </div>
    <div
      class="mx-auto max-w-7xl px-6 py-8 flex flex-wrap items-center gap-4 text-[14px] text-ink/55"
    >
      <img src="/prototype/yeride-mark.svg" alt="" class="h-6 w-auto" />
      <span>{t.footerNote}</span>
      <span class="ml-auto">© 2026 YeRide</span>
    </div>
  </section>
</div>
