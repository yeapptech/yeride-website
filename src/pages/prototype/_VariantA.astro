---
// PROTOTYPE (wayfinder #33) — Variant A: "The Fork"
// Light-first. The tagline is a slim brand bar; the hero IS the audience split —
// two symmetric full-height doors, Pullman ground vs Paper ground. Choosing a side
// is the page's primary affordance. Cab Yellow appears only as button fill.
import { copy, type Lang } from './_copy';
const { lang } = Astro.props as { lang: Lang };
const t = copy[lang];
const other = lang === 'en' ? 'es' : 'en';
---

<div class="min-h-screen flex flex-col bg-paper font-brand">
  <!-- brand bar: lockup + tagline + nav -->
  <header class="border-b border-ink/10">
    <div class="mx-auto max-w-7xl px-6 py-5 flex items-center gap-6">
      <a href="/" class="shrink-0">
        <img src="/prototype/yeride-lockup.svg" alt="YeRide" class="h-8 w-auto" />
      </a>
      <p class="hidden lg:block text-ink/70 text-[15px] border-l border-ink/15 pl-6">
        {t.tagline}
      </p>
      <nav class="ml-auto flex items-center gap-7 text-[15px] font-semibold text-ink/80">
        <a href="/fees" class="hover:text-ink">{t.nav.fees}</a>
        <a href="/fare-estimate" class="hover:text-ink">{t.nav.estimate}</a>
        <a href="/about" class="hidden sm:inline hover:text-ink">{t.nav.about}</a>
        <a
          href={`?variant=A&lang=${other}`}
          class="rounded-full border border-ink/25 px-3 py-1 text-xs font-bold uppercase tracking-caps text-ink/70 hover:border-ink/50"
          >{other}</a
        >
      </nav>
    </div>
    <!-- tagline on small screens, where it can't sit inline -->
    <p class="lg:hidden mx-auto max-w-7xl px-6 pb-4 text-ink/70 text-[15px]">{t.tagline}</p>
  </header>

  <!-- THE FORK — two symmetric doors, full height -->
  <div class="flex-1 grid md:grid-cols-2">
    <!-- driver door: Pullman ground, reversed mark, paper text -->
    <section class="bg-pullman-brown flex items-center">
      <div class="w-full max-w-xl mx-auto px-8 py-16 md:py-24">
        <img src="/prototype/yeride-mark-reversed.svg" alt="" class="h-10 w-auto opacity-90" />
        <p class="mt-8 text-xs font-bold uppercase tracking-caps text-paper/60">
          {t.driverEyebrow}
        </p>
        <h2
          class="mt-3 text-paper font-extrabold tracking-headline text-[clamp(2.25rem,4.2vw,3.5rem)] leading-[1.05]"
        >
          {t.driverOffer}
        </h2>
        <p class="mt-5 text-paper/75 text-[17px] leading-relaxed max-w-md">{t.driverSupport}</p>
        <a
          href="/drivers"
          class="mt-9 inline-flex items-center gap-2 rounded-full bg-cab-yellow px-7 py-3.5 text-ink font-bold text-[17px] hover:brightness-95"
        >
          {t.driverCta}
          <span aria-hidden="true">→</span>
        </a>
      </div>
    </section>

    <!-- rider door: Paper ground, primary mark, ink text -->
    <section class="bg-paper flex items-center border-t md:border-t-0 md:border-l border-ink/10">
      <div class="w-full max-w-xl mx-auto px-8 py-16 md:py-24">
        <img src="/prototype/yeride-mark.svg" alt="" class="h-10 w-auto" />
        <p class="mt-8 text-xs font-bold uppercase tracking-caps text-ink/50">{t.riderEyebrow}</p>
        <h2
          class="mt-3 text-ink font-extrabold tracking-headline text-[clamp(2.25rem,4.2vw,3.5rem)] leading-[1.05]"
        >
          {t.riderOffer}
        </h2>
        <p class="mt-5 text-ink/70 text-[17px] leading-relaxed max-w-md">{t.riderSupport}</p>
        <a
          href="/riders"
          class="mt-9 inline-flex items-center gap-2 rounded-full bg-cab-yellow px-7 py-3.5 text-ink font-bold text-[17px] hover:brightness-95"
        >
          {t.riderCta}
          <span aria-hidden="true">→</span>
        </a>
      </div>
    </section>
  </div>

  <!-- shared proof strip — the one thing both sides are told -->
  <section class="bg-paper border-t border-ink/10">
    <div class="mx-auto max-w-7xl px-6 py-14">
      <div class="grid sm:grid-cols-3 gap-px bg-ink/10 border-y border-ink/10">
        {
          t.facts.map((f) => (
            <div class="bg-paper px-6 py-8">
              <span class="block h-1 w-10 bg-cab-yellow" />
              <p class="mt-4 text-ink font-bold text-[22px] tracking-headline">{f}</p>
            </div>
          ))
        }
      </div>
      <div class="mt-8 flex flex-wrap items-center justify-between gap-4">
        <p class="text-ink/55 text-[15px]">{t.factsNote}</p>
        <a href="/fees" class="text-ink font-bold text-[15px] underline underline-offset-4"
          >{t.feesCta} →</a
        >
      </div>
    </div>
  </section>

  <footer class="bg-paper border-t border-ink/10">
    <div
      class="mx-auto max-w-7xl px-6 py-8 flex flex-wrap items-center gap-4 text-[14px] text-ink/55"
    >
      <img src="/prototype/yeride-mark.svg" alt="" class="h-6 w-auto" />
      <span>{t.footerNote}</span>
      <span class="ml-auto">© 2026 YeRide</span>
    </div>
  </footer>
</div>
