---
// PROTOTYPE (wayfinder #33) — Variant E: "The Statement"
// The anti-hero. No poster type, no split, no artifact — a single narrow column of
// reading matter on Ink, structured like a printed notice. Nothing is bigger than it
// needs to be; the page is ordered by reading sequence, not by layout. The fork
// arrives last, as two quiet links, because the argument comes first.
// Cab Yellow appears as the item numerals — text, which is permitted on dark grounds
// for brand moments only (brand-system.md).
import { copy, type Lang } from './_copy';
const { lang } = Astro.props as { lang: Lang };
const t = copy[lang];
const other = lang === 'en' ? 'es' : 'en';

const items = [
  { n: '01', offer: t.driverOffer, support: t.driverSupport, cta: t.driverCta, href: '/drivers' },
  { n: '02', offer: t.riderOffer, support: t.riderSupport, cta: t.riderCta, href: '/riders' },
];
---

<div class="font-brand bg-ink min-h-screen flex flex-col">
  <header class="border-b border-paper/15">
    <div class="mx-auto max-w-3xl px-6 py-5 flex items-center gap-5">
      <a href="/" class="shrink-0">
        <img src="/prototype/yeride-mark-reversed.svg" alt="YeRide" class="h-8 w-auto" />
      </a>
      <nav
        class="ml-auto flex items-center gap-6 text-[14px] font-semibold text-paper/65"
      >
        <a href="/fees" class="hover:text-paper">{t.nav.fees}</a>
        <a href="/fare-estimate" class="hover:text-paper">{t.nav.estimate}</a>
        <a
          href={`?variant=E&lang=${other}`}
          class="rounded-full border border-paper/30 px-3 py-1 text-xs font-bold uppercase tracking-caps hover:border-paper/70"
          >{other}</a
        >
      </nav>
    </div>
  </header>

  <main class="flex-1 mx-auto w-full max-w-3xl px-6 py-16 md:py-24">
    <!-- the tagline is a sentence here, not a poster -->
    <p
      class="text-paper font-bold tracking-headline text-[clamp(1.6rem,3.2vw,2.5rem)] leading-[1.2]"
    >
      {t.tagline}
    </p>
    <p class="mt-5 text-paper/60 text-[17px] leading-relaxed">{t.statementLead}</p>

    <ol class="mt-14 border-t border-paper/15">
      {
        items.map((it) => (
          <li class="border-b border-paper/15 py-10 grid grid-cols-[3rem_1fr] gap-6">
            {/* brand-moment accent — Cab Yellow as text, dark ground only */}
            <span class="text-cab-yellow font-extrabold text-[20px] leading-none pt-1">{it.n}</span>
            <div>
              <h2 class="text-paper font-bold tracking-headline text-[clamp(1.4rem,2.4vw,1.9rem)] leading-[1.15]">
                {it.offer}
              </h2>
              <p class="mt-3 text-paper/65 text-[16px] leading-relaxed">{it.support}</p>
              <a
                href={it.href}
                class="mt-5 inline-flex items-center gap-2 text-paper font-bold text-[15px] underline underline-offset-4 hover:no-underline"
              >
                {it.cta}
                <span aria-hidden="true">→</span>
              </a>
            </div>
          </li>
        ))
      }
      <li class="border-b border-paper/15 py-10 grid grid-cols-[3rem_1fr] gap-6">
        <span class="text-cab-yellow font-extrabold text-[20px] leading-none pt-1">03</span>
        <div>
          <h2
            class="text-paper font-bold tracking-headline text-[clamp(1.4rem,2.4vw,1.9rem)] leading-[1.15]"
          >
            {t.feesBanner}
          </h2>
          <p class="mt-3 text-paper/65 text-[16px] leading-relaxed">
            {t.feesSupport}
          </p>
          <a
            href="/fees"
            class="mt-5 inline-flex items-center gap-2 text-paper font-bold text-[15px] underline underline-offset-4 hover:no-underline"
          >
            {t.feesCta}
            <span aria-hidden="true">→</span>
          </a>
        </div>
      </li>
    </ol>
  </main>

  <footer class="border-t border-paper/15">
    <div
      class="mx-auto max-w-3xl px-6 py-8 flex flex-wrap items-center gap-4 text-[14px] text-paper/55"
    >
      <span>{t.footerNote}</span>
      <span class="ml-auto">© 2026 YeRide</span>
    </div>
  </footer>
</div>
