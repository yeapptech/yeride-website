<!doctype html>
<html>
  <head>
    <title>Redirecting...</title>
    <script>
      const deepLink = `yeride://register`;

      window.location.href = deepLink;

      setTimeout(() => {
        document.getElementById("manualLink").style.display = "block";
      }, 2000);
    </script>
  </head>
  <body>
    <p>Redirecting to the app...</p>
    <a id="manualLink" href="yeride://register" style="display: none;"
      >Click here if you are not redirected</a
    >
  </body>
</html>
