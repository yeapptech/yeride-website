---
// Pre-registration form — copy-map §2.2. One component, embedded on /drivers
// and /riders, with `role` PRE-SET by page: the dropdown is gone, so the page
// you are on is the role you register for.
//
// See src/i18n/formCopy.ts for the two deviations from §2.2 (no password
// fields; a duplicate phone number gets its own line) and why the endpoint
// forces both.
import { formCopy } from "../i18n/formCopy";
import type { Lang } from "../i18n/feesCopy";

export interface Props {
  lang: Lang;
  role: "driver" | "rider";
  heading: string;
  sub: string;
}
const { lang, role, heading, sub } = Astro.props;
const t = formCopy[lang];

const fields = [
  {
    name: "firstName",
    type: "text",
    autocomplete: "given-name",
    label: t.firstNameLabel,
    placeholder: t.firstNamePlaceholder,
    half: true,
  },
  {
    name: "lastName",
    type: "text",
    autocomplete: "family-name",
    label: t.lastNameLabel,
    placeholder: t.lastNamePlaceholder,
    half: true,
  },
  {
    name: "email",
    type: "email",
    autocomplete: "email",
    label: t.emailLabel,
    placeholder: t.emailPlaceholder,
    half: false,
  },
  {
    name: "phoneNumber",
    type: "tel",
    autocomplete: "tel",
    label: t.phoneLabel,
    placeholder: t.phonePlaceholder,
    half: false,
  },
] as const;

const inputClass =
  "mt-1.5 block w-full rounded-xl border border-ink/60 bg-white px-4 py-3 text-[16px] text-ink placeholder:text-ink/65 focus:border-ink focus:outline-none focus:ring-1 focus:ring-ink";
---

<section
  id="pre-register"
  class="rounded-2xl border border-ink/15 bg-white/60 px-5 py-7 sm:px-8 sm:py-9"
>
  {/* Both lines instruct an action that has already happened once the success
      state renders, so they go with the form. */}
  <div data-prereg-intro>
    <h2 class="font-extrabold tracking-headline text-[1.5rem] leading-tight text-ink">
      {heading}
    </h2>
    <p class="mt-1.5 text-[15px] text-ink/75">{sub}</p>
  </div>

  <form data-prereg novalidate class="mt-6">
    {/* The role is the page, not a choice — copy-map §2.2. This input is the
        single source of it; the submit handler reads the field like any other
        rather than keeping a second copy on a data attribute. */}
    <input type="hidden" name="role" value={role} />

    <div class="grid gap-4 sm:grid-cols-2">
      {
        fields.map((f) => (
          <div class:list={[!f.half && "sm:col-span-2"]}>
            <label
              for={`prereg-${f.name}`}
              class="text-[14px] font-bold text-ink"
            >
              {f.label}
            </label>
            <input
              id={`prereg-${f.name}`}
              name={f.name}
              type={f.type}
              autocomplete={f.autocomplete}
              placeholder={f.placeholder}
              aria-describedby={`prereg-${f.name}-error`}
              class={inputClass}
            />
            <p
              id={`prereg-${f.name}-error`}
              data-error-for={f.name}
              hidden
              class="mt-1.5 text-[13.5px] font-semibold text-pullman-brown"
            >
            </p>
          </div>
        ))
      }
    </div>

    <button
      type="submit"
      data-submit
      class="mt-6 flex w-full items-center justify-center rounded-full bg-ink px-8 py-4 text-[16px] font-bold text-paper hover:bg-pullman-brown disabled:opacity-60 sm:w-auto"
    >
      {t.submit}
    </button>

    {/* Server outcomes (§2.2) land here, one class at a time. The raw API
        string is logged, never shown.

        Deliberately NOT hidden when empty: a live region has to be in the
        accessibility tree before its text changes, or the change is not
        announced. Writing into a display:none node and then revealing it is
        the common way to ship an alert that never speaks. */}
    <p
      data-form-message
      role="alert"
      class="mt-4 text-[15px] font-semibold text-pullman-brown empty:mt-0"
    >
    </p>
  </form>

  {/* The success state. The availability block (§2.1) is the page's next
      element, so it stays on screen beneath this line rather than being
      duplicated inside the form.

      Unlike the alert above, this one IS revealed from `hidden` — announcement
      here comes from moving focus to it, not from a live region, so it does not
      need to pre-exist in the accessibility tree. */}
  <p
    data-prereg-success
    hidden
    role="status"
    tabindex="-1"
    class="text-[1.25rem] font-extrabold tracking-headline text-ink focus:outline-none"
  >
    {t.success}
  </p>
</section>

<script>
  import { formCopy } from "../i18n/formCopy";
  import type { Lang } from "../i18n/feesCopy";

  const lang = (document.documentElement.lang === "es" ? "es" : "en") as Lang;
  const t = formCopy[lang];

  const form = document.querySelector<HTMLFormElement>("[data-prereg]");
  const intro = document.querySelector<HTMLElement>("[data-prereg-intro]");
  const submit = document.querySelector<HTMLButtonElement>("[data-submit]");
  const message = document.querySelector<HTMLParagraphElement>("[data-form-message]");
  const success = document.querySelector<HTMLElement>("[data-prereg-success]");

  if (form && submit && message && success) {
    const field = (name: string) =>
      form.querySelector<HTMLInputElement>(`[name="${name}"]`);
    const errorSlot = (name: string) =>
      form.querySelector<HTMLElement>(`[data-error-for="${name}"]`);

    const EMAIL = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;

    /** Whatever they type, the wire format is E.164 — the endpoint dedupes on an
     *  exact string match, so two spellings of one number are two people to it.
     *
     *  Strips formatting only (spaces incl. NBSP, brackets, dots, and the ASCII
     *  and Unicode dashes), never letters or digits. A bare 10-digit number gets
     *  the +1 the old form used to force, so a phone autofilled as
     *  "(305) 555-0100" still normalises instead of landing on a red error. */
    const e164 = (raw: string) => {
      const stripped = raw.trim().replace(/[\s ().\-‐-―]/g, "");
      return /^\d{10}$/.test(stripped) ? `+1${stripped}` : stripped;
    };

    /** E.164 shape: "+", a country code that cannot start with 0, 10–15 digits
     *  total — so "+001 305…", a dialling prefix, is not a country code.
     *
     *  NANP (+1) is pinned to exactly 11 digits, and that is the whole point
     *  rather than a nicety. The general 10–15 range accepts BOTH a US number
     *  with a digit dropped and a US number with an extension run onto the end:
     *  "+1 305 555 0100 2" reads as valid, and writes a second row beside the
     *  same person's +13055550100. Stripping only formatting characters does not
     *  catch that on its own — the stray character is a digit. */
    const PHONE = /^\+[1-9]\d{9,14}$/;
    const NANP = /^\+1\d{10}$/;
    const validPhone = (raw: string) => {
      const n = e164(raw);
      return n.startsWith("+1") ? NANP.test(n) : PHONE.test(n);
    };

    /** Per-field validation, copy-map §2.2. Returns the message, or null. */
    function validate(name: string, value: string): string | null {
      if (!value.trim()) return t.required;
      if (name === "email" && !EMAIL.test(value.trim())) return t.badEmail;
      if (name === "phoneNumber" && !validPhone(value)) return t.badPhone;
      return null;
    }

    function showFieldError(name: string, text: string | null) {
      const input = field(name);
      const slot = errorSlot(name);
      if (!input || !slot) return;
      slot.textContent = text ?? "";
      slot.hidden = !text;
      input.setAttribute("aria-invalid", text ? "true" : "false");
      input.classList.toggle("border-pullman-brown", Boolean(text));
    }

    const names = ["firstName", "lastName", "email", "phoneNumber"];

    // Errors appear on blur only once the person has been told about them —
    // no page-load wall of red on empty fields.
    let submitted = false;
    for (const name of names) {
      field(name)?.addEventListener("blur", () => {
        if (submitted) showFieldError(name, validate(name, field(name)!.value));
      });
      field(name)?.addEventListener("input", () => {
        if (submitted) showFieldError(name, validate(name, field(name)!.value));
      });
    }

    // The node stays in the tree; only its text changes, so the live region
    // actually announces.
    function setMessage(text: string | null) {
      message!.textContent = text ?? "";
    }

    /** Which §2.2 outcome class a response falls into. */
    async function outcome(response: Response): Promise<string> {
      let code = "";
      let raw = "";
      try {
        const body = await response.json();
        code = typeof body?.code === "string" ? body.code : "";
        raw = typeof body?.error === "string" ? body.error : "";
      } catch {
        /* a body that will not parse tells us nothing the status does not */
      }
      // The raw API string is logged, never displayed (§2.2).
      console.error("[pre-registration] rejected", response.status, code, raw);

      if (code.includes("email-already-in-use")) return t.emailTaken;
      if (code.includes("phone-number-already-in-use")) return t.phoneTaken;
      if (response.status >= 500) return t.server;
      if (response.status >= 400) return t.rejected;
      return t.server;
    }

    form.addEventListener("submit", async (event) => {
      event.preventDefault();
      submitted = true;
      setMessage(null);

      let firstBad: string | null = null;
      for (const name of names) {
        const error = validate(name, field(name)!.value);
        showFieldError(name, error);
        if (error && !firstBad) firstBad = name;
      }
      if (firstBad) {
        field(firstBad)!.focus();
        return;
      }

      const apiUrl = import.meta.env.PUBLIC_API_URL;
      if (!apiUrl) {
        console.error("[pre-registration] PUBLIC_API_URL is not set");
        setMessage(t.server);
        return;
      }

      submit!.disabled = true;
      submit!.textContent = t.submitting;

      const data = {
        firstName: field("firstName")!.value.trim(),
        lastName: field("lastName")!.value.trim(),
        email: field("email")!.value.trim(),
        phoneNumber: e164(field("phoneNumber")!.value),
        role: field("role")!.value,
      };

      try {
        const response = await fetch(`${apiUrl}v1/auth/register`, {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ data }),
        });

        if (response.ok) {
          form!.hidden = true;
          if (intro) intro.hidden = true;
          success!.hidden = false;
          success!.focus?.();
          return;
        }
        setMessage(await outcome(response));
      } catch (error) {
        console.error("[pre-registration] could not reach the server", error);
        setMessage(t.network);
      } finally {
        submit!.disabled = false;
        submit!.textContent = t.submit;
      }
    });
  }
</script>
