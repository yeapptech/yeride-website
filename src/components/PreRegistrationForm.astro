---
// PreRegistrationForm.astro
---

<div class="bg-white/95 backdrop-blur rounded-lg shadow-lg">
  <div class="p-8">
    <form id="pre-registration-form" class="space-y-6">
      <div class="grid md:grid-cols-2 gap-4">
        <div>
          <label for="firstName" class="text-gray-700 font-medium block mb-1">
            First Name
          </label>
          <input
            id="firstName"
            name="firstName"
            type="text"
            class="mt-2 block w-full px-4 py-2 border border-gray-300 rounded-md shadow-sm focus:ring-blue-500 focus:border-blue-500 sm:text-sm"
            placeholder="Enter your first name"
            required
          />
        </div>
        <div>
          <label for="lastName" class="text-gray-700 font-medium block mb-1">
            Last Name
          </label>
          <input
            id="lastName"
            name="lastName"
            type="text"
            class="mt-2 block w-full px-4 py-2 border border-gray-300 rounded-md shadow-sm focus:ring-blue-500 focus:border-blue-500 sm:text-sm"
            placeholder="Enter your last name"
            required
          />
        </div>
      </div>

      <div>
        <label
          for="email"
          class="text-gray-700 font-medium block mb-1"
        >
          Email Address
        </label>
        <input
          id="email"
          name="email"
          type="email"
          class="mt-2 block w-full px-4 py-2 border border-gray-300 rounded-md shadow-sm focus:ring-blue-500 focus:border-blue-500 sm:text-sm"
          placeholder="Enter your email address"
          required
        />
      </div>

      <!-- <div class="grid md:grid-cols-2 gap-4">
        <div>
          <label
            for="password"
            class="text-gray-700 font-medium block mb-1"
          >
            Password
          </label>
          <input
            id="password"
            name="password"
            type="password"
            class="mt-2 block w-full px-4 py-2 border border-gray-300 rounded-md shadow-sm focus:ring-blue-500 focus:border-blue-500 sm:text-sm"
            placeholder="Create a password"
            required
          />
        </div>
        <div>
          <label
            for="confirmPassword"
            class="text-gray-700 font-medium block mb-1"
          >
            Confirm Password
          </label>
          <input
            id="confirmPassword"
            name="confirmPassword"
            type="password"
            class="mt-2 block w-full px-4 py-2 border border-gray-300 rounded-md shadow-sm focus:ring-blue-500 focus:border-blue-500 sm:text-sm"
            placeholder="Confirm your password"
            required
          />
        </div>
      </div> -->
      <div class="grid md:grid-cols-2 gap-4">
        <div>
          <label for="phoneNumber" class="text-gray-700 font-medium block mb-1">
            Phone Number
          </label>
          <input
            id="phoneNumber"
            name="phoneNumber"
            type="tel"
            class="mt-2 block w-full px-4 py-2 border border-gray-300 rounded-md shadow-sm focus:ring-blue-500 focus:border-blue-500 sm:text-sm"
            placeholder="+12345678900"
            value="+1"
            pattern="^\+1\d{10}$"
            required
            data-prefix="+1"
          />
        </div>
        <div>
          <label class="text-gray-700 font-medium block mb-1">
            I want to join as
          </label>
          <div class="relative">
            <select
              id="role"
              name="role"
              required
              class="mt-2 block w-full px-4 py-2 border border-gray-300 rounded-md shadow-sm focus:ring-blue-500 focus:border-blue-500 sm:text-sm appearance-none pr-8"
            >
              <option value="" disabled selected>Select your role</option>
              <option value="rider">Rider</option>
              <option value="driver">Driver</option>
            </select>
            <div
              class="pointer-events-none absolute inset-y-0 right-0 flex items-center px-2 text-gray-700"
            >
              <svg
                class="fill-current h-4 w-4"
                xmlns="http://www.w3.org/2000/svg"
                viewBox="0 0 20 20"
                ><path
                  d="M9.293 12.95l.707.707L15.657 8l-1.414-1.414L10 10.828 6.757 7.586 5.343 9z"
                ></path></svg
              >
            </div>
          </div>
        </div>
      </div>

      <button
        type="submit"
        id="submit-button"
        class="w-full bg-blue-600 hover:bg-blue-700 text-white py-3 text-lg font-semibold rounded-md shadow-md transition duration-300
                disabled:bg-gray-400 disabled:cursor-not-allowed disabled:hover:bg-gray-400"
        disabled
      >
        Submit
      </button>
      <div
        id="loading-indicator"
        class="hidden text-center text-blue-700 mt-4"
      >
        <svg
          class="animate-spin h-5 w-5 mr-3 inline-block"
          viewBox="0 0 24 24"
        >
          <circle
            class="opacity-25"
            cx="12"
            cy="12"
            r="10"
            stroke="currentColor"
            stroke-width="4"></circle>
          <path
            class="opacity-75"
            fill="currentColor"
            d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"
          ></path>
        </svg>
        Sending...
      </div>
      <div id="form-message" class="hidden text-center mt-4"></div>
    </form>
  </div>
</div>

<script is:inline define:vars={{ API_URL: import.meta.env.PUBLIC_API_URL }}>
  const preRegistrationForm = document.getElementById("pre-registration-form");
  const submitButton = document.getElementById("submit-button");
  const loadingIndicator = document.getElementById("loading-indicator");
  const formMessage = document.getElementById("form-message");
  const phoneNumberInput = document.getElementById("phoneNumber");

  function validateForm() {
    if (!preRegistrationForm) return false;

    let allFieldsValid = true;
    const requiredInputs = preRegistrationForm.querySelectorAll("[required]");
    console.debug("Validating form fields:", requiredInputs);

    requiredInputs.forEach((input) => {
      console.debug("Validating input:", input.id, "Value:", input.value);
      if (input.id === "phoneNumber") {
        const prefix = input.dataset.prefix || "";
        const expectedLength = prefix.length + 10;

        if (
          !input.value.startsWith(prefix) ||
          input.value.length !== expectedLength ||
          !/^\+\d{11}$/.test(input.value)
        ) {
          allFieldsValid = false;
        }
      } else if (!input.checkValidity()) {
        allFieldsValid = false;
      }
    });

    // const passwordInput = document.getElementById("password");
    // const confirmPasswordInput = document.getElementById("confirmPassword");
    // if (
    //   passwordInput &&
    //   confirmPasswordInput &&
    //   passwordInput.value !== confirmPasswordInput.value
    // ) {
    //   allFieldsValid = false;
    //   const errorMessage = "Error: Passwords do not match.";
    //   formMessage.textContent = `Error: ${errorMessage}`;
    //   formMessage.classList.remove("hidden");
    //   formMessage.classList.add("text-red-600");
    // } else {
    //   formMessage.textContent = "";
    //   formMessage.classList.add("hidden");
    //   formMessage.classList.remove("text-green-600", "text-red-600");
    // }

    const roleSelect = document.getElementById("role");
    if (roleSelect && roleSelect.value === "") {
      allFieldsValid = false;
    }

    if (submitButton) {
      submitButton.disabled = !allFieldsValid;
    }
    console.debug("Form validation result:", allFieldsValid);
    return allFieldsValid;
  }

  if (phoneNumberInput) {
    const prefix = phoneNumberInput.dataset.prefix || ""; // Obtener el prefijo del atributo data-prefix
    const maxDigits = 10; // Número máximo de dígitos después del prefijo

    if (!phoneNumberInput.value.startsWith(prefix)) {
      phoneNumberInput.value = prefix;
    }

    phoneNumberInput.addEventListener("keydown", (e) => {
      const currentValue = phoneNumberInput.value;
      const digitsPart = currentValue.substring(prefix.length);

      // Prevenir borrar el prefijo
      if (
        e.key === "Backspace" &&
        phoneNumberInput.selectionStart <= prefix.length
      ) {
        e.preventDefault();
        return;
      }

      // Prevenir escribir más de 10 dígitos
      if (
        digitsPart.length >= maxDigits &&
        /\d/.test(e.key) &&
        !e.ctrlKey &&
        !e.altKey &&
        !e.metaKey &&
        e.key !== "Backspace" &&
        e.key !== "Delete" &&
        e.key !== "ArrowLeft" &&
        e.key !== "ArrowRight" &&
        e.key !== "Tab"
      ) {
        e.preventDefault();
      }
    });

    phoneNumberInput.addEventListener("input", () => {
      let value = phoneNumberInput.value;

      if (!value.startsWith(prefix)) {
        value = prefix;
      }

      // Eliminar caracteres no numéricos después del prefijo
      const digitsOnly = value.substring(prefix.length).replace(/\D/g, "");
      value = prefix + digitsOnly;

      // Limitar a 10 dígitos después del prefijo
      if (digitsOnly.length > maxDigits) {
        value = prefix + digitsOnly.substring(0, maxDigits);
      }

      phoneNumberInput.value = value;
      validateForm();
    });

    phoneNumberInput.addEventListener("focus", () => {
      if (!phoneNumberInput.value.startsWith(prefix)) {
        phoneNumberInput.value = prefix;
      }
      // Mover el cursor al final del prefijo si está al principio
      if (phoneNumberInput.selectionStart < prefix.length) {
        phoneNumberInput.setSelectionRange(prefix.length, prefix.length);
      }
    });

    // Ajustar el cursor si el usuario hace clic antes del prefijo
    phoneNumberInput.addEventListener("click", () => {
      if (phoneNumberInput.selectionStart < prefix.length) {
        phoneNumberInput.setSelectionRange(prefix.length, prefix.length);
      }
    });
  }

  if (preRegistrationForm && submitButton && loadingIndicator && formMessage) {
    preRegistrationForm.addEventListener("input", validateForm);
    const roleSelect = document.getElementById("role");
    if (roleSelect) {
      roleSelect.addEventListener("change", validateForm);
    }

    preRegistrationForm.addEventListener("submit", async (e) => {
      e.preventDefault();

      formMessage.textContent = "";
      formMessage.classList.add("hidden");
      formMessage.classList.remove("text-green-600", "text-red-600");

      submitButton.disabled = true;
      submitButton.classList.add("opacity-50", "cursor-not-allowed");
      loadingIndicator.classList.remove("hidden");

      const formData = new FormData(preRegistrationForm);
      const data = {};
      formData.forEach((value, key) => {
        data[key] = value.toString();
      });

      // if (
      //   data["password"] !== undefined &&
      //   data["confirmPassword"] !== undefined &&
      //   data["password"] !== data["confirmPassword"]
      // ) {
      //   formMessage.textContent = "Error: Passwords do not match.";
      //   formMessage.classList.remove("hidden");
      //   formMessage.classList.add("text-red-600");
      //   submitButton.disabled = false;
      //   submitButton.classList.remove("opacity-50", "cursor-not-allowed");
      //   loadingIndicator.classList.add("hidden");
      //   return;
      // }

      if (!API_URL) {
        console.error("PUBLIC_API_URL no está definida");
        formMessage.textContent =
          "Error: Configuración del servidor no disponible.";
        formMessage.classList.remove("hidden");
        formMessage.classList.add("text-red-600");
        submitButton.disabled = false;
        submitButton.classList.remove("opacity-50", "cursor-not-allowed");
        loadingIndicator.classList.add("hidden");
        return;
      }

      try {
        const response = await fetch(`${API_URL}v1/auth/register`, {
          method: "POST",
          headers: {
            "Content-Type": "application/json",
          },
          body: JSON.stringify({ data: data }),
        });

        const result = await response.json();

        if (response.ok) {
          formMessage.textContent = "Pre-registration successful! Thank you.";
          formMessage.classList.remove("hidden");
          formMessage.classList.add("text-green-600");
          preRegistrationForm.reset();
        } else {
          console.debug("Error response:", result);
          const errorMessage =
            result.error || "An error occurred during pre-registration.";
          formMessage.textContent = `Error: ${errorMessage}`;
          formMessage.classList.remove("hidden");
          formMessage.classList.add("text-red-600");
        }
      } catch (error) {
        console.error("Error submitting form:", error);
        formMessage.textContent =
          "Error: Could not connect to the server. Please try again later.";
        formMessage.classList.remove("hidden");
        formMessage.classList.add("text-red-600");
      } finally {
        submitButton.disabled = false;
        submitButton.classList.remove("opacity-50", "cursor-not-allowed");
        loadingIndicator.classList.add("hidden");
      }
    });
  }
</script>