---
// / and /es/ — the approved Variant D language, "The Hail" (wayfinder #33):
// Cab Yellow ground with the MARK leading instead of type, inversion to an Ink
// fork band, landing on paper. Copy verbatim from docs/copy-map.md §3.1.
//
// Two restructures the copy map makes to the comp:
//   · the audience fork moves UP into the yellow hero — the comp's hero CTA
//     pointed at /fees, which is demoted to the nav and the paper strip;
//   · the Ink band DROPS its buttons. It keeps both eyebrows, both canonical
//     offer lines and their support, and each half links as a whole block, so
//     no CTA repeats within one scroll.
//
// The home page carries no pre-registration form. Its job is the fork.
//
// Brand: the lockup embeds the primary mark, which logo.md forbids on Cab
// Yellow, so the app-icon scheme is the only legal mark on this ground; Cab
// Yellow runs as TEXT for the eyebrows, legal on the dark band only (#33).
import appIcon from "@yeapptech/yeride-brand/assets/logo/yeride-app-icon.svg";
import { homeCopy } from "../i18n/homeCopy";
import type { Lang } from "../i18n/feesCopy";

export interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = homeCopy[lang];
const esPrefix = lang === "es" ? "/es" : "";

const fork = [
  {
    eyebrow: t.driverEyebrow,
    h2: t.driverH2,
    support: t.driverSupport,
    href: `${esPrefix}/drivers`,
  },
  {
    eyebrow: t.riderEyebrow,
    h2: t.riderH2,
    support: t.riderSupport,
    href: `${esPrefix}/riders`,
  },
];
---

<main>
  {/* YELLOW GROUND — the mark leads, the fork is the CTA pair */}
  <section class="bg-cab-yellow">
    <div
      class="mx-auto grid w-full max-w-7xl gap-7 px-5 pb-14 pt-2 sm:px-6 sm:pb-20 md:grid-cols-[auto_1fr] md:items-center md:gap-16 md:pb-28 md:pt-6"
    >
      {/* the shipped app icon at size; its yellow bleed merges with the ground */}
      <img
        src={appIcon.src}
        alt=""
        class="-ml-3 h-auto w-32 shrink-0 sm:w-44 md:-ml-8 md:w-72 lg:w-80"
      />
      <div>
        <h1
          class="max-w-3xl font-extrabold tracking-headline text-[2rem] leading-[1.06] text-ink sm:text-[2.75rem] md:text-[clamp(3rem,6vw,5rem)] md:leading-[1.0]"
        >
          {t.h1}
        </h1>
        <p
          class="mt-4 max-w-xl text-[16px] text-ink/75 sm:text-[18px] md:mt-6 md:text-[clamp(1.05rem,1.5vw,1.3rem)]"
        >
          {t.sub}
        </p>
        <div class="mt-7 flex flex-col gap-3 sm:flex-row sm:items-center md:mt-9">
          <a
            href={`${esPrefix}/drivers`}
            class="flex items-center justify-center gap-2 rounded-full bg-ink px-8 py-4 text-[17px] font-bold text-paper hover:bg-pullman-brown sm:inline-flex"
          >
            {t.driverCta}
            <span aria-hidden="true">→</span>
          </a>
          <a
            href={`${esPrefix}/riders`}
            class="flex items-center justify-center gap-2 rounded-full border-2 border-ink px-8 py-[14px] text-[17px] font-bold text-ink hover:bg-ink hover:text-paper sm:inline-flex"
          >
            {t.riderCta}
            <span aria-hidden="true">→</span>
          </a>
        </div>
      </div>
    </div>
  </section>

  {/* INK BAND — the two offers. No buttons: each half links as a whole block. */}
  <section class="bg-ink">
    <div
      class="mx-auto grid max-w-7xl gap-12 px-5 py-14 sm:px-6 sm:py-16 md:grid-cols-2 md:gap-20 md:py-20"
    >
      {
        fork.map((side) => (
          <a href={side.href} class="group block">
            {/* Cab Yellow as text — legal on dark grounds only (#33) */}
            <p class="text-xs font-bold uppercase tracking-caps text-cab-yellow">
              {side.eyebrow}
            </p>
            <h2 class="mt-3 font-extrabold tracking-headline text-[1.6rem] leading-[1.1] text-paper sm:text-[2rem] md:mt-4 md:text-[clamp(2rem,3.4vw,2.75rem)]">
              {side.h2}
            </h2>
            <p class="mt-3 text-[16px] leading-relaxed text-paper/70 sm:text-[17px] md:mt-4">
              {side.support}
            </p>
            {/* The block is the link, so the affordance is a mark rather than a
                second CTA (§3.1). It sits on its own line: trailing the H2, it
                orphaned onto a line of its own whenever the headline wrapped. */}
            <span
              aria-hidden="true"
              class="mt-5 inline-block text-[1.5rem] leading-none text-cab-yellow transition-transform group-hover:translate-x-1 md:mt-6"
              >→</span
            >
          </a>
        ))
      }
    </div>
  </section>

  {/* PAPER LANDING — the facts, the limit, the fee link */}
  <section class="bg-paper">
    <div class="mx-auto max-w-7xl px-5 sm:px-6">
      <ul
        class="border-b border-ink/10 py-4 md:flex md:flex-wrap md:items-center md:gap-x-10 md:py-14"
      >
        {
          t.facts.map((fact) => (
            <li class="border-b border-ink/10 py-4 last:border-b-0 md:border-b-0 md:py-0">
              <span class="font-bold tracking-headline text-[18px] text-ink sm:text-[20px]">
                {fact}
              </span>
            </li>
          ))
        }
        <li class="py-4 md:ml-auto md:py-0">
          <span class="text-[15px] text-ink/75">{t.limitNote}</span>
        </li>
      </ul>
      <div class="py-8 md:py-10">
        <a
          href={`${esPrefix}/fees`}
          class="inline-flex items-center gap-2 text-[17px] font-bold text-ink underline underline-offset-4 hover:no-underline"
        >
          {t.feesLink}
          <span aria-hidden="true">→</span>
        </a>
      </div>
    </div>
  </section>
</main>
