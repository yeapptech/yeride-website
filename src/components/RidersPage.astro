---
// /riders and /es/riders — copy verbatim from docs/copy-map.md §3.3, on the
// same "The Hail" language and the same block vocabulary as /drivers: eyebrow,
// pillars, fee pointer, form, availability.
//
// /riders RESERVES NOTHING. Rider pillar 2 is ungated (§5) and runs at launch
// in its natural position, so at launch this page carries one support couplet
// more than /drivers — symmetry is block vocabulary, not section count (#43).
//
// "Card or cash." is canonical but marked *supporting* in docs/messaging.md: it
// runs as a lead-in line inside the pillar stack and never as a headline (§3.3).
// Cleared to run by research/cash-statute.md — Fla. Stat. § 627.748 imposes no
// electronic-payment mandate.
import { ridersCopy } from "../i18n/audienceCopy";
import type { Lang } from "../i18n/feesCopy";
import PreRegistrationForm from "./PreRegistrationForm.astro";
import AvailabilityBlock from "./AvailabilityBlock.astro";

export interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = ridersCopy[lang];
const esPrefix = lang === "es" ? "/es" : "";
---

<main>
  {/* YELLOW GROUND — pillar 1 leads the page */}
  <section class="bg-cab-yellow">
    <div class="mx-auto w-full max-w-7xl px-5 pb-14 pt-4 sm:px-6 sm:pb-20 md:pb-24 md:pt-8">
      <p class="text-xs font-bold uppercase tracking-caps text-ink/60">
        {t.eyebrow}
      </p>
      <h1
        class="mt-3 max-w-4xl font-extrabold tracking-headline text-[2rem] leading-[1.06] text-ink sm:text-[2.75rem] md:text-[clamp(3rem,6vw,4.5rem)] md:leading-[1.0]"
      >
        {t.h1}
      </h1>
      <p
        class="mt-4 max-w-2xl text-[16px] leading-relaxed text-ink/75 sm:text-[18px] md:mt-6 md:text-[clamp(1.05rem,1.5vw,1.25rem)]"
      >
        {t.support}
      </p>
    </div>
  </section>

  {/* INK BAND — the rest of the pillar stack */}
  <section class="bg-ink">
    <div
      class="mx-auto max-w-7xl divide-y divide-paper/15 px-5 py-4 sm:px-6 md:py-8"
    >
      <section class="py-10 md:py-14">
        <h2
          class="max-w-3xl font-extrabold tracking-headline text-[1.6rem] leading-[1.15] text-paper sm:text-[2rem] md:text-[clamp(2rem,3.2vw,2.5rem)]"
        >
          {t.pillar2H2}
        </h2>
        <p
          class="mt-3 max-w-2xl text-[16px] leading-relaxed text-paper/70 sm:text-[17px] md:mt-4"
        >
          {t.pillar2Support}
        </p>
      </section>

      {/* pillar 3 — a support couplet, deliberately not an H2 */}
      <section class="py-10 md:py-14">
        <p class="text-[18px] font-bold text-paper sm:text-[20px]">
          {t.payLine}
        </p>
        <p
          class="mt-2 max-w-2xl text-[16px] leading-relaxed text-paper/70 sm:text-[17px]"
        >
          {t.paySupport}
        </p>
      </section>
    </div>
  </section>

  {/* PAPER LANDING — the fee pointer and the estimate, then the form */}
  <section class="bg-paper">
    <div class="mx-auto max-w-7xl px-5 sm:px-6">
      <div
        class="flex flex-col gap-3 border-b border-ink/10 py-8 md:flex-row md:items-baseline md:justify-between md:gap-10 md:py-10"
      >
        <h3 class="font-extrabold tracking-headline text-[1.25rem] text-ink sm:text-[1.4rem]">
          {t.feeH3}
        </h3>
        <div class="flex flex-col gap-3 sm:flex-row sm:items-baseline sm:gap-8">
          <a
            href={`${esPrefix}/fees`}
            class="inline-flex items-center gap-2 text-[17px] font-bold text-ink underline underline-offset-4 hover:no-underline"
          >
            {t.feeLink}
            <span aria-hidden="true">→</span>
          </a>
          <a
            href={`${esPrefix}/fare-estimate`}
            class="inline-flex items-center gap-2 text-[17px] font-bold text-ink underline underline-offset-4 hover:no-underline"
          >
            {t.estimateLink}
            <span aria-hidden="true">→</span>
          </a>
        </div>
      </div>

      <div class="max-w-2xl py-10 md:py-14">
        <PreRegistrationForm
          lang={lang}
          role="rider"
          heading={t.formHeading}
          sub={t.formSub}
        />
        <AvailabilityBlock lang={lang} />
      </div>
    </div>
  </section>
</main>
