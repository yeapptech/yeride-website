---
// Site footer — copy per docs/copy-map.md §1.2. Social is X/Twitter only;
// the Facebook/Instagram icons pointed at "#" and are removed for good.
import mark from "@yeapptech/yeride-brand/assets/logo/yeride-mark.svg";
import { copyright } from "../i18n/utilityCopy";

export interface Props {
  lang?: "en" | "es";
}
const { lang = "en" } = Astro.props;

// Stamped at build time — see `copyright` in src/i18n/utilityCopy.ts for why the
// year is taken here rather than hard-coded or read in the browser.
const year = new Date().getFullYear();

const t = {
  en: {
    about: "About",
    contact: "Contact",
    privacy: "Privacy Policy",
    terms: "Terms",
    place: "Built in South Florida.",
    entity: "YeRide is built by YeAPP TECH LLC, a Florida software company.",
    xAria: "YeRide on X",
  },
  es: {
    about: "Nosotros",
    contact: "Contacto",
    privacy: "Privacidad",
    terms: "Términos",
    place: "Hecho en el Sur de la Florida.",
    entity:
      "YeRide es un producto de YeAPP TECH LLC, una empresa de software de la Florida.",
    xAria: "YeRide en X",
  },
}[lang];

const esPrefix = lang === "es" ? "/es" : "";
---

<footer class="border-t border-ink/10 bg-paper">
  <div class="mx-auto w-full max-w-7xl px-5 py-10 sm:px-6">
    <div class="flex flex-wrap items-center gap-x-6 gap-y-4">
      <a href={`${esPrefix}/`} class="shrink-0">
        <img src={mark.src} alt="YeRide" class="h-6 w-auto" />
      </a>
      <nav
        class="flex flex-wrap items-center gap-x-5 gap-y-2 text-[15px] font-semibold text-ink/60"
      >
        <a href={`${esPrefix}/about`} class="hover:text-ink">{t.about}</a>
        <a href={`${esPrefix}/contact`} class="hover:text-ink">{t.contact}</a>
        <a href={`${esPrefix}/privacy-policy`} class="hover:text-ink"
          >{t.privacy}</a
        >
        <a href={`${esPrefix}/terms`} class="hover:text-ink">{t.terms}</a>
      </nav>
      <a
        href="https://twitter.com/yeride_app"
        aria-label={t.xAria}
        class="ml-auto text-ink/60 hover:text-ink"
      >
        <svg class="h-6 w-6" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path
            d="M8.29 20.251c7.547 0 11.675-6.253 11.675-11.675 0-.178 0-.355-.012-.53A8.348 8.348 0 0022 5.92a8.19 8.19 0 01-2.357.646 4.118 4.118 0 001.804-2.27 8.224 8.224 0 01-2.605.996 4.107 4.107 0 00-6.993 3.743 11.65 11.65 0 01-8.457-4.287 4.106 4.106 0 001.27 5.477A4.072 4.072 0 012.8 9.713v.052a4.105 4.105 0 003.292 4.022 4.095 4.095 0 01-1.853.07 4.108 4.108 0 003.834 2.85A8.233 8.233 0 012 18.407a11.616 11.616 0 006.29 1.84"
          ></path>
        </svg>
      </a>
    </div>
    <div class="mt-6 space-y-1 text-[14px] text-ink/55">
      <p>{t.place}</p>
      <p>{t.entity}</p>
      <p>{copyright(year)}</p>
    </div>
  </div>
</footer>
