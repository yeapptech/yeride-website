<div id="results-container" class="hidden mt-8">
  <div id="route-summary" class="bg-blue-50 rounded-lg p-6 mb-6">
    <h3 class="text-xl font-semibold text-gray-900 mb-3">Route Summary</h3>
    <div class="flex flex-wrap gap-8">
      <div>
        <span class="text-gray-500 text-sm">Distance</span>
        <p id="route-distance" class="text-lg font-semibold text-gray-900">--</p>
      </div>
      <div>
        <span class="text-gray-500 text-sm">Estimated Time</span>
        <p id="route-duration" class="text-lg font-semibold text-gray-900">--</p>
      </div>
    </div>
  </div>

  <h3 class="text-xl font-semibold text-gray-900 mb-4">Available Services</h3>
  <div id="estimates-list" class="space-y-4">
    <!-- Dynamically populated by JS -->
  </div>
</div>
