# Copy to .env and fill in. All six are required: `npm run build` fails on a
# missing or empty one (scripts/check-env.mjs). `npm run dev`, `npm run checks`
# and `npx astro check` need none of them.
#
# This file is the authoritative list of variable NAMES and their shapes.
# `npm run checks` fails if it and scripts/env-required.mjs disagree, so the two
# cannot drift. What each one is FOR, and what specifically breaks without it,
# is in CLAUDE.md and in the `breaks` strings in scripts/env-required.mjs.
#
# On deploy these come from GitHub Secrets, written to .env line by line by
# .github/workflows/deploy-all.yml's "Create env file" step. A secret that has
# been renamed or never created interpolates to the empty string, which is the
# case check-env.mjs exists to catch.

# yeride-admin-api. MUST end with a trailing slash — the pre-registration form
# appends `v1/auth/register` straight onto it.
#
# This is the real production value, not an example. It is already public: it
# is inlined into the bundle at build time and is readable in the shipped HTML
# of /drivers/. The value these docs used to show, https://api.yeride.com/, is
# NXDOMAIN — it has never resolved, so anyone who followed it was configuring a
# host that does not exist (#70).
PUBLIC_API_URL=https://api-dx7ooik7ca-uc.a.run.app/

# The five below are secrets and have no publishable value. See the repository
# secrets, or ask, for the real ones.
#
# The placeholders are deliberately invalid, but be exact about WHEN that bites,
# because it is NOT at the build. check-env.mjs asks whether a value is present,
# printable ASCII, and — for PUBLIC_API_URL — slash-terminated. It says so about
# itself: "it checks that a value EXISTS, never that it works." Every placeholder
# below passes all three, so `cp .env.example .env && npm run build` is GREEN with
# five fake keys in place.
#
# They fail in the browser instead, one page at a time: Google Maps rejects the
# key and /fare-estimate shows its service-error line on arrival, initializeApp
# builds a Firebase app whose estimateFares callable never answers, and /fees
# renders its designed error state and publishes no rate card.
#
# So this file gets you a build, not a working site. Fill the five in before
# judging anything on a page.

# Google Maps JS API key, used by /fare-estimate's address inputs and map.
PUBLIC_GOOGLE_MAPS_API_KEY=replace-me

# Firebase web config. These three feed one initializeApp() call; the site uses
# firebase/functions only — no Auth, no Firestore.
PUBLIC_FIREBASE_API_KEY=replace-me
PUBLIC_FIREBASE_AUTH_DOMAIN=replace-me.firebaseapp.com
PUBLIC_FIREBASE_PROJECT_ID=replace-me

# Public getFeeSchedule endpoint, read at runtime by /fees and /es/fees.
PUBLIC_FEE_SCHEDULE_URL=https://example.invalid/getFeeSchedule
