# environment variables
# Every file Vite loads, in any mode: .env, .env.local, .env.[mode] and
# .env.[mode].local. Listed one mode at a time, this misses whichever mode
# is added next; .env.development.local is a real key file and was tracked.
.env*
!.env.example

# macOS-specific files
.DS_Store
.qodo

.env-dev
.env-prod

.vscode
